# If /api/servers fails with that error, point MIRURO_URL at a working
# Miruro deployment.
MIRURO_URL=https://miruro-api-theta.vercel.app

# === App ===
ITEMS_PER_PAGE=20
CACHE_TTL_SECONDS=300

